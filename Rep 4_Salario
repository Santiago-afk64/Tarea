Algoritmo Salario anual()
//Declaraciones
  Definir salario como entero
  Definir año como real

//Cuerpo
  salario <- 1500
  Para año <- 1 hasta 6 hacer
    salario <- salario * 0.1
    Escribir "Salario al finalizar el año", salario
  FinPara
  Escribir "Su salario despues de 6 años es:", salario
FinAlgoritmo
