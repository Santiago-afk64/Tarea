Algoritmo Suma de numero hasta 0
//Declaraciones
  Definir N como enteros

//Cuerpo
  Suma <- 0
  Escribir "Ingrese un numero (0 para terminar"
  Leer N

  Mientras N <> 0 hacer
    Suma <- Suma + N
    Escribir "Ingrese otro numero (0 para terminar)"
    Leer N
  FinMientras
  Escribir "La suma final es:", Suma
FinAlgoritmo
